	"tasks": [
		{
			"uuid": "bac4b0c9-9cf9-4233-97d7-bde0bb6a2d2c",
			"title": "Оптимизировать авто-тесты",
			"description": "Сейчас при выполнении задач прогоняется большое кол-во тестов, порой не относящихся к задаче, или вовсе невыполнимых после изменения функционала.\n\nЭто нужно исправить, разделив автотесты на смысловые/функциональные категории, и запуская выполнение только одной конкретной категории + 2 смежные для подстраховки.\n\nЦель - не расходовать впустую токены ИИ-агента на прогон не относящихся к теме тестов (например: при тестировании кнопки включения освещения на станции нет никакого смысла тестировать окружающий космос снаружи).",
			"category": "bd73e186-9cad-43ee-8337-927a38339605",
			"steps": []
		},
		{
			"uuid": "6ddacec2-9508-4937-a6c6-72b222604a24",
			"title": "Протестировать \"мост\" для работы с Orchestrator'ом",
			"description": "Возможно следует вынести мост в отдельный пакет, но сперва нуно понять что имеем на выходе (нужно создать в оркестраторе граф, который на входе принимает что-то через мост и также передаёт на выходе)\n\nНужно зафиксировать в инструкциях как это использовать ИИ-агенту.\nТакже нужна инструкция для разработчика-человека.",
			"category": "bd73e186-9cad-43ee-8337-927a38339605",
			"steps": []
		},
		{
			"uuid": "ebf0de5a-4d86-424c-a74e-9e6db13f7b21",
			"title": "Протестировать создание функционала ИИ-агентом через Orchestrator",
			"description": "Нужно понять возможности ИИ-агента при работе с Orchestrator'ом.\nВ случае успеха можно создать скилл для ИИ-агента (обсуждаемо).",
			"category": "bd73e186-9cad-43ee-8337-927a38339605",
			"steps": []
		},
		{
			"uuid": "ac3f3c6f-e668-4885-859d-96a98a8bff46",
			"title": "Переделать перемещение игрока в режиме невесомости",
			"description": "Перемещение игрока по отсекам на продольной оси станции в режиме невесомости реализовано, но нужно упростить управление, сделав его в режиме \"летающей камеры\":\n\nW - вперед (куда смотрит камера)\nS - назад\nA - стрейф влево\nD - стрейф вправо\nCtrl - стрейф вниз\nShift - стрейф вверх\nZ - крен влево\nX - крен вправо",
			"category": "bd73e186-9cad-43ee-8337-927a38339605",
			"steps": []
		},
		{
			"uuid": "d20c0e42-1128-4749-ae6e-bd2b2a3bff81",
			"title": "Изменить геометрию отсеков и модулей станции, добавив толщину мешам",
			"description": "Сейчас отсеки станции это просто плоскости в том или ином виде, а нужно чтобы это были объемные меши - стенкам отсеков нужна толщина для возможности полноценного текстурирования внешней и внутренней UV-развертки.",
			"category": "bd73e186-9cad-43ee-8337-927a38339605",
			"steps": []
		}
	],
